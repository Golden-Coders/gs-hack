# Adresy backendów; który jest aktywny, wybiera się w UI (zapamiętane w przeglądarce).
VITE_MOCK_URL=http://localhost:4010
VITE_API_URL=http://localhost:8080
# Backend przy pierwszym uruchomieniu: mock (npm run mock) albo api (gateway). Domyślnie api.
VITE_DEFAULT_BACKEND=mock
VITE_API_TOKEN=dev-token
