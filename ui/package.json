{
  "name": "alerting-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mock": "prism mock ../contracts/openapi.yaml --port 4010 --host 0.0.0.0",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
